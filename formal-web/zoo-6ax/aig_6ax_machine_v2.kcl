@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// AIG-II 6AX Zoo CAD V2 / Visual V9 authority model.
// Visual authority intent: full enclosed industrial machining center with
// twin heavy trunnion supports, central Z spindle, open machining envelope,
// dark graphite body and discrete AIG RGB trim.
// Engineering coordinate system: X left/right, Y front/rear, Z up.
// Runtime hierarchy contract remains C -> B -> A.
// Concept model only. NOT manufacturing-certified.

aShaftOD = 62
aBearingOD = 168
aHousingOD = 236
bShaftOD = 54
bBearingOD = 142
bHousingOD = 214
cBaseOD = 300
cTableOD = 338

frameColor = "#050A10"
panelColor = "#111923"
paintColor = "#17242E"
steelColor = "#9AA7AC"
darkSteel = "#46565E"
railColor = "#68767C"
workColor = "#C9922E"
toolColor = "#E3ECEF"
rgbCyan = "#00D9FF"
rgbBlue = "#3867FF"
rgbViolet = "#9D4DFF"
rgbPink = "#FF3BA7"
rgbAmber = "#FFB03A"

fn makeBox(@cx, cy, z0, sx, sy, sz, color) {
  body = startSketchOn(XY)
    |> startProfile(at = [-sx / 2, -sy / 2])
    |> xLine(length = sx)
    |> yLine(length = sy)
    |> xLine(length = -sx)
    |> close()
    |> extrude(length = sz)
    |> translate(xyz = [cx, cy, z0], global = true)
    |> appearance(color = color)
  return body
}
fn rawCylinderX(@length, od) { return startSketchOn(YZ) |> circle(center = [0, 0], radius = od / 2) |> extrude(length = length) }
fn rawCylinderY(@length, od) { return startSketchOn(XZ) |> circle(center = [0, 0], radius = od / 2) |> extrude(length = length) }
fn rawCylinderZ(@length, od) { return startSketchOn(XY) |> circle(center = [0, 0], radius = od / 2) |> extrude(length = length) }
fn makeCylinderX(@cx, cy, cz, length, od, color) { return rawCylinderX(length, od = od) |> translate(xyz = [cx - length / 2, cy, cz], global = true) |> appearance(color = color) }
fn makeCylinderY(@cx, cy, cz, length, od, color) { return rawCylinderY(length, od = od) |> translate(xyz = [cx, cy - length / 2, cz], global = true) |> appearance(color = color) }
fn makeCylinderZ(@cx, cy, cz, length, od, color) { return rawCylinderZ(length, od = od) |> translate(xyz = [cx, cy, cz - length / 2], global = true) |> appearance(color = color) }
fn makeRingX(@cx, cy, cz, length, od, id, color) { outer = rawCylinderX(length, od = od); inner = rawCylinderX(length + 4, od = id) |> translate(x = -2, global = true); return subtract(outer, tools = [inner]) |> translate(xyz = [cx - length / 2, cy, cz], global = true) |> appearance(color = color) }
fn makeRingY(@cx, cy, cz, length, od, id, color) { outer = rawCylinderY(length, od = od); inner = rawCylinderY(length + 4, od = id) |> translate(y = -2, global = true); return subtract(outer, tools = [inner]) |> translate(xyz = [cx, cy - length / 2, cz], global = true) |> appearance(color = color) }
fn makeRingZ(@cx, cy, cz, length, od, id, color) { outer = rawCylinderZ(length, od = od); inner = rawCylinderZ(length + 4, od = id) |> translate(z = -2, global = true); return subtract(outer, tools = [inner]) |> translate(xyz = [cx, cy, cz - length / 2], global = true) |> appearance(color = color) }
fn makePrismX(@cx, cy, cz, length, od, sides, color) { return startSketchOn(YZ) |> polygon(radius = od / 2, numSides = sides, center = [0, 0]) |> extrude(length = length) |> translate(xyz = [cx - length / 2, cy, cz], global = true) |> appearance(color = color) }

STATIC_BED = makeBox(0, cy = 0, z0 = 0, sx = 1500, sy = 980, sz = 105, color = frameColor)
