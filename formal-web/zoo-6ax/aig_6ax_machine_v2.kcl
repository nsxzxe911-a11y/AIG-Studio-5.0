X_RAIL_UPPER = makeBox(0, cy = 302, z0 = 700, sx = 860, sy = 28, sz = 32, color = railColor)
X_RAIL_LOWER = makeBox(0, cy = 302, z0 = 628, sx = 860, sy = 28, sz = 32, color = railColor)
Z_RAIL_LEFT = makeBox(-82, cy = 285, z0 = 405, sx = 34, sy = 34, sz = 330, color = railColor)
Z_RAIL_RIGHT = makeBox(82, cy = 285, z0 = 405, sx = 34, sy = 34, sz = 330, color = railColor)
SPINDLE_CARRIAGE = makeBox(0, cy = 255, z0 = 500, sx = 265, sy = 210, sz = 250, color = paintColor)
SPINDLE_HEAD = makeBox(0, cy = 160, z0 = 430, sx = 190, sy = 180, sz = 255, color = panelColor)
SPINDLE_GUARD = makeCylinderZ(0, cy = 68, cz = 445, length = 180, od = 146, color = darkSteel)
SPINDLE_NOSE = makeCylinderZ(0, cy = 68, cz = 338, length = 82, od = 82, color = steelColor)
TOOL_HOLDER = makeCylinderZ(0, cy = 68, cz = 278, length = 68, od = 48, color = darkSteel)
TOOL = makeCylinderZ(0, cy = 68, cz = 220, length = 92, od = 12, color = toolColor)
C_AXIS_BASE = makeCylinderZ(0, cy = 0, cz = 158, length = 110, od = cBaseOD, color = paintColor)
C_AXIS_TABLE = makeCylinderZ(0, cy = 0, cz = 225, length = 54, od = cTableOD, color = darkSteel)
C_AXIS_RING = makeRingZ(0, cy = 0, cz = 246, length = 36, od = 382, id = 344, color = steelColor)
bAxisZ = 365
bSupportY = 172
B_SUPPORT_FRONT = makeRingY(0, cy = -bSupportY, cz = bAxisZ, length = 68, od = bHousingOD, id = 158, color = paintColor)
B_SUPPORT_REAR = makeRingY(0, cy = bSupportY, cz = bAxisZ, length = 68, od = bHousingOD, id = 158, color = paintColor)
B_BEARING_FRONT = makeRingY(0, cy = -bSupportY, cz = bAxisZ, length = 74, od = bBearingOD, id = 66, color = steelColor)
B_BEARING_REAR = makeRingY(0, cy = bSupportY, cz = bAxisZ, length = 74, od = bBearingOD, id = 66, color = steelColor)
B_JOURNAL_FRONT = makeCylinderY(0, cy = -bSupportY, cz = bAxisZ, length = 98, od = bShaftOD, color = darkSteel)
B_JOURNAL_REAR = makeCylinderY(0, cy = bSupportY, cz = bAxisZ, length = 98, od = bShaftOD, color = darkSteel)
B_CRADLE = makeBox(0, cy = 0, z0 = 285, sx = 610, sy = 310, sz = 42, color = paintColor)
B_CRADLE_LEFT_ARM = makeBox(-285, cy = 0, z0 = 310, sx = 64, sy = 310, sz = 255, color = paintColor)
B_CRADLE_RIGHT_ARM = makeBox(285, cy = 0, z0 = 310, sx = 64, sy = 310, sz = 255, color = paintColor)
B_CRADLE_LEFT_FOOT = makeBox(-285, cy = 0, z0 = 260, sx = 118, sy = 330, sz = 70, color = panelColor)
B_CRADLE_RIGHT_FOOT = makeBox(285, cy = 0, z0 = 260, sx = 118, sy = 330, sz = 70, color = panelColor)
aAxisZ = 420
aSupportX = 282
A_SUPPORT_LEFT = makeRingX(-aSupportX, cy = 0, cz = aAxisZ, length = 118, od = aHousingOD, id = 182, color = paintColor)
A_SUPPORT_RIGHT = makeRingX(aSupportX, cy = 0, cz = aAxisZ, length = 118, od = aHousingOD, id = 182, color = paintColor)
A_BEARING_LEFT = makeRingX(-aSupportX, cy = 0, cz = aAxisZ, length = 128, od = aBearingOD, id = 78, color = steelColor)
A_BEARING_RIGHT = makeRingX(aSupportX, cy = 0, cz = aAxisZ, length = 128, od = aBearingOD, id = 78, color = steelColor)
A_SHAFT_LEFT = makeCylinderX(-aSupportX, cy = 0, cz = aAxisZ, length = 146, od = aShaftOD, color = darkSteel)
A_SHAFT_RIGHT = makeCylinderX(aSupportX, cy = 0, cz = aAxisZ, length = 146, od = aShaftOD, color = darkSteel)
A_BODY = makeCylinderX(0, cy = 0, cz = aAxisZ, length = 430, od = 98, color = darkSteel)
CHUCK = makeCylinderX(0, cy = 0, cz = aAxisZ, length = 214, od = 158, color = steelColor)
WORKPIECE_HUB = makeCylinderX(0, cy = 0, cz = aAxisZ, length = 138, od = 116, color = darkSteel)
WORKPIECE = makePrismX(0, cy = 0, cz = aAxisZ, length = 118, od = 132, sides = 12, color = workColor)

// C pivot [0,0,225] +Z; B pivot [0,0,365] +Y; A pivot [0,0,420] +X.
// Motion hierarchy: C rotates B + A; B rotates complete A assembly; A rotates chuck/work.
// Review: A ±180deg, B at least ±60deg, C ±180deg.
