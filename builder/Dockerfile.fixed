FROM gradle:9.6.0-jdk17 AS builder
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY builder/aig432.tgz.b64 /payload/aig432.tgz.b64
RUN base64 -d /payload/aig432.tgz.b64 > /tmp/aig432.tgz && echo 'aa0b8958a2f4f04e0e9df189eb258e62799d620e7004e35dd84d286746c5b9d4  /tmp/aig432.tgz' | sha256sum -c - && mkdir -p /src432 && tar -xzf /tmp/aig432.tgz -C /src432
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/36.0.0:$PATH
RUN mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-sdk && curl -fL --retry 4 --retry-delay 2 https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o /tmp/android-sdk/cmdline-tools.zip && echo '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583  /tmp/android-sdk/cmdline-tools.zip' | sha256sum -c - && unzip -q /tmp/android-sdk/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && yes | sdkmanager --licenses >/dev/null || true
RUN sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0'
WORKDIR /src432/android-official-fifth-432
COPY builder/patch434/ /patch434/
COPY uiux/assets/ /formal-assets/
RUN cp -rf /patch434/. . && mkdir -p core-ui/src/main/res/drawable-nodpi && cp /formal-assets/home.png core-ui/src/main/res/drawable-nodpi/aig_home.png && cp /formal-assets/cad.png core-ui/src/main/res/drawable-nodpi/aig_cad.png && cp /formal-assets/cam.jpg core-ui/src/main/res/drawable-nodpi/aig_cam.jpg && cp /formal-assets/sim.jpg core-ui/src/main/res/drawable-nodpi/aig_sim.jpg && cp /formal-assets/axis3.jpg core-ui/src/main/res/drawable-nodpi/aig_axis3.jpg && cp /formal-assets/axis4.png core-ui/src/main/res/drawable-nodpi/aig_axis4.png && cp /formal-assets/axis5.jpg core-ui/src/main/res/drawable-nodpi/aig_axis5.jpg && cp /formal-assets/machine.jpg core-ui/src/main/res/drawable-nodpi/aig_machine.jpg && sed -i 's/-Xmx4g/-Xmx1g/' gradle.properties && python3 ci/verify_official_android_434.py && gradle :app:assembleDebug --stacktrace --no-daemon && mkdir -p /out && cp app/build/outputs/apk/debug/app-debug.apk /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk && apksigner verify --verbose /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk > /out/apksigner.txt && aapt dump badging /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk > /out/apk-badging.txt && sha256sum /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk | tee /out/apk-sha256.txt && printf '%s\n' 'AIG_VERSION=434.0.0' 'ANDROID_SDK=36' 'BUILD_TOOLS=36.0.0' 'GRADLE=9.6.0' 'AGP=9.4.0' 'FORMAL_RUNTIME_GATE=PASS' 'APK_BUILD=PASS' 'APK_SIGNATURE_VERIFY=PASS' 'ENGINEERING_SHELL=REMOVED' 'RGB_SKIN=PACKAGED' 'SIM_NUMERIC_REMOVAL=HEIGHT_FIELD' '3AX_4AX_5AX_6AX_RENDERER=OPENGL_ES' '6AX_VARIANT=VERTICAL_ONLY' 'RUNTIME_DEVICE_SCREENSHOT=NOT_YET_VERIFIED' > /out/evidence.txt && printf '%s\n' '<!doctype html><html><body style="background:#020407;color:white;font-family:sans-serif;padding:32px"><h1>AIG-II / AIG CNC 434</h1><p>Android SDK 36 + OpenGL ES runtime.</p><p><a style="color:#00e5ff;font-size:22px" href="/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk">下載 434 APK</a></p><p><a style="color:#aaa" href="/apk-sha256.txt">SHA-256</a> · <a style="color:#aaa" href="/evidence.txt">Evidence</a></p></body></html>' > /out/index.html
FROM python:3.12-alpine
WORKDIR /site
COPY --from=builder /out/ /site/
ENV PORT=10000
EXPOSE 10000
CMD ["python3","-u","-m","http.server","10000","--bind","0.0.0.0"]
