FROM gradle:9.6.0-jdk17 AS builder
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip python3 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN curl -fL --retry 4 --retry-delay 2 'https://sdmntprkoreacentral.oaiusercontent.com/files/00000000-fad4-8206-96a2-836527781579/raw?se=2026-10-12T04%3A53%3A25Z&sp=r&sv=2026-02-06&sr=b&scid=b76f699c-ab7a-51c1-bfff-b3b4bafbeb4b&skoid=fe2e0858-51c5-47e9-acb7-46ebb9a0f396&sktid=a48cca56-e6da-484e-a814-9c849652bcb3&skt=2026-10-12T01%3A18%3A29Z&ske=2026-10-13T01%3A18%3A29Z&sks=b&skv=2026-02-06&sig=vBYO1GwxOL6F0BvqEoZzeK7B4uKVkYwGDJ13F3hFT1w%3D' -o /tmp/aig433.tgz && echo '20404d2e59089f34e737df22e64c96a83ec25f880e272678e590192ede5938a1  /tmp/aig433.tgz' | sha256sum -c - && mkdir -p /src433 && tar -xzf /tmp/aig433.tgz -C /src433
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/36.0.0:$PATH
RUN mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-sdk && curl -fL --retry 4 --retry-delay 2 https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o /tmp/android-sdk/cmdline-tools.zip && echo '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583  /tmp/android-sdk/cmdline-tools.zip' | sha256sum -c - && unzip -q /tmp/android-sdk/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && yes | sdkmanager --licenses >/dev/null || true
RUN sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0'
WORKDIR /src433/android-official-fifth-433
COPY builder/patch434/ /patch434/
RUN cp -rf /patch434/. . && sed -i 's/-Xmx4g/-Xmx1g/' gradle.properties && python3 ci/verify_official_android_434.py && gradle :app:assembleDebug --stacktrace --no-daemon && mkdir -p /out && cp app/build/outputs/apk/debug/app-debug.apk /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk && apksigner verify --verbose /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk > /out/apksigner.txt && aapt dump badging /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk > /out/apk-badging.txt && sha256sum /out/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk | tee /out/apk-sha256.txt && printf '%s\n' 'AIG_VERSION=434.0.0' 'ANDROID_SDK=36' 'BUILD_TOOLS=36.0.0' 'GRADLE=9.6.0' 'AGP=9.4.0' 'FORMAL_RUNTIME_GATE=PASS' 'APK_BUILD=PASS' 'APK_SIGNATURE_VERIFY=PASS' 'ENGINEERING_SHELL=REMOVED' 'RGB_SKIN=PACKAGED' 'SIM_NUMERIC_REMOVAL=HEIGHT_FIELD' '3AX_4AX_5AX_6AX_RENDERER=OPENGL_ES' '6AX_VARIANT=VERTICAL_ONLY' 'RUNTIME_DEVICE_SCREENSHOT=NOT_YET_VERIFIED' > /out/evidence.txt && printf '%s\n' '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AIG Fifth 434 APK</title></head><body style="background:#020407;color:#fff;font-family:sans-serif;padding:32px"><h1>AIG-II / AIG CNC 434</h1><p>Android SDK 36 / OpenGL ES runtime.</p><p><a style="color:#00e5ff;font-size:22px" href="/AIG_II_AIG_CNC_434_OFFICIAL_DEBUG.apk">下載 434 APK</a></p><p><a href="/apk-sha256.txt" style="color:#aaa">SHA-256</a> · <a href="/evidence.txt" style="color:#aaa">Evidence</a></p></body></html>' > /out/index.html
FROM python:3.12-alpine
WORKDIR /site
COPY --from=builder /out/ /site/
ENV PORT=10000
EXPOSE 10000
CMD ["python3","-u","-m","http.server","10000","--bind","0.0.0.0"]
