<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIGStudio" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#020407</item>
        <item name="android:colorAccent">#27E9FF</item>
        <item name="android:navigationBarColor">#020407</item>
        <item name="android:statusBarColor">#020407</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/Widget.AIG.RgbButton</item>
        <item name="android:editTextStyle">@style/Widget.AIG.RgbInput</item>
        <item name="android:spinnerStyle">@style/Widget.AIG.RgbSpinner</item>
        <item name="android:checkboxStyle">@style/Widget.AIG.RgbCheckBox</item>
        <item name="android:seekBarStyle">@style/Widget.AIG.RgbSeekBar</item>
    </style>

    <style name="Widget.AIG.RgbButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/aig_rgb_glass_button</item>
        <item name="android:textColor">#F4FBFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.AIG.RgbInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/aig_rgb_glass_input</item>
        <item name="android:textColor">#F4FBFF</item>
        <item name="android:textColorHint">#8FA9B8C6</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.AIG.RgbSpinner" parent="@android:style/Widget.Material.Spinner.Underlined">
        <item name="android:background">@drawable/aig_rgb_glass_input</item>
        <item name="android:popupBackground">@drawable/aig_rgb_glass_panel</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="Widget.AIG.RgbCheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:textColor">#F4FBFF</item>
        <item name="android:buttonTint">#27E9FF</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.AIG.RgbSeekBar" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:progressTint">#27E9FF</item>
        <item name="android:secondaryProgressTint">#33F39B</item>
        <item name="android:thumbTint">#FF4DA6</item>
    </style>
</resources>
