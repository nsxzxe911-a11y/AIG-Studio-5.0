<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIGStudio" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:navigationBarColor">#07111B</item>
        <item name="android:statusBarColor">#07111B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.AIGStudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080C16</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AIGStudio</item>
    </style>
</resources>
