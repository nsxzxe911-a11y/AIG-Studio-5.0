<?xml version='1.0' encoding='utf-8'?>
<aigCacheUpdateStandard schema="aig-cache-update-xml-v1" product="AIG Studio 5.0" version="354.0.0">
  <announcement language="zh-TW">
    所有部門快取更新一律以 XML 結構內容、revision、contentDigest/SHA-256 與 sourceExactSha 為判斷標準。
    禁止只依檔案加工時間、mtime、lastModified、timestamp 判斷新舊、是否更新、是否覆蓋或責任歸屬。
  </announcement>
  <authority primary="XML_CONTENT_AND_DIGEST" networkRequired="false" chatStateRequired="false" />
  <decision>
    <requiredField name="revision" />
    <requiredField name="contentDigest" algorithm="SHA-256" />
    <requiredField name="sourceExactSha" />
    <requiredField name="xmlStructuralIdentity" />
    <optionalField name="observedTimestamp" decisionAuthority="false" />
    <optionalField name="fileMtime" decisionAuthority="false" />
  </decision>
  <forbidden>
    <criterion id="MTIME_ONLY" />
    <criterion id="LAST_MODIFIED_ONLY" />
    <criterion id="PROCESSING_TIME_ONLY" />
    <criterion id="TIMESTAMP_ONLY" />
    <criterion id="FILE_DATE_ONLY" />
  </forbidden>
  <updateRule>
    <when>revision differs OR contentDigest differs OR sourceExactSha differs OR XML structural identity differs</when>
    <action>REFRESH_CACHE_FROM_VERIFIED_SOURCE</action>
    <otherwise>KEEP_VERIFIED_CACHE</otherwise>
  </updateRule>
  <conflictRule>
    <rule>NEVER_OVERWRITE_NEWER_REVISION_WITH_OLDER_REVISION</rule>
    <rule>SAME_REVISION_DIFFERENT_DIGEST_IS_CONFLICT</rule>
    <rule>NETWORK_FAILURE_DOES_NOT_INVALIDATE_VERIFIED_LOCAL_CACHE</rule>
    <rule>UNRELATED_DEPARTMENTS_CONTINUE</rule>
  </conflictRule>
  <departments>
    <department id="HOME" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
    <department id="CAD" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
    <department id="CAM" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
    <department id="SIM" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
