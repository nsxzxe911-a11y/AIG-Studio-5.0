    <department id="6AX" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
    <department id="NC" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
    <department id="AI" mode="XML_CACHE_STANDARD" mtimeAuthority="false" digestRequired="true" revisionRequired="true" sourceExactShaRequired="true" />
