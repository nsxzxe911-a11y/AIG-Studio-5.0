{
  "schema": "aig-ai-responsibility-routing-v1",
  "product": "AIG Studio 5.0",
  "version": "339.0.0",
  "detector": "AI",
  "principle": "AI_DETECTS_CLASSIFIES_RETURNS_REWORK_REVERIFIES; OWNER_DEPARTMENT_FIXES",
  "lifecycle": [
    "EXECUTE",
    "AI_AUTOCHECK",
    "ASSIGN_OWNER",
    "RETURN_FOR_REWORK",
    "OWNER_REDO",
    "AI_REVERIFY",
    "PASS_COMPLETE"
  ],
  "close_rule": "ONLY_AI_REVERIFY_PASS_CAN_MARK_COMPLETE",
  "ownership": {
    "HOME_ROUTING": "HOME",
    "STARTUP_RUNTIME_ENTRY": "HOME",
    "CAD_GEOMETRY": "CAD",
    "CAD_SNAP_DIM_EDIT": "CAD",
    "CAM_TOOLPATH": "CAM",
    "CAM_SAFE_Z_TOOLING": "CAM",
    "SIM_MATERIAL_REMOVAL": "SIM",
    "SIM_COLLISION_PLAYBACK": "SIM",
    "AXIS3_KINEMATICS": "3AX",
    "AXIS4_A_ROTATION": "4AX",
    "AXIS5_AB_TCP": "5AX",
    "NC_FANUC_POST": "NC",
    "NC_GCODE_SAFETY": "NC",
    "AI_UPDATE_RECOVERY": "AI",
    "UI_LAYOUT_THEME_LANGUAGE": "UIUX",
    "ANDROID_COMPILE_PACKAGE_LAUNCH": "ANDROID_BUILD",
    "WINDOWS_COMPILE_PACKAGE_LAUNCH": "WINDOWS_BUILD",
    "WEB_RUNTIME_PREVIEW": "WEB",
    "AXIS6_ABC_POSTURE": "6AX",
    "AXIS6_COLLISION_SPACE": "6AX",
    "AXIS6_COLLISION_LOOKAHEAD": "6AX",
    "AXIS6_MANUAL_CAM_EDIT_CONTINUITY": "6AX",
    "AXIS6_MANUAL_CAM_ORIENTATION_EDIT": "6AX",
    "AXIS6_MACHINE_POST": "NC",
    "PROFESSIONAL_CROSS_AUDIT": "PRO_AUDIT",
    "PROFESSIONAL_REPAIR_ORCHESTRATION": "PRO_AUDIT",
    "STALE_GATE_DETECTION": "PRO_AUDIT",
    "AUDIT_REPORT_EVIDENCE_CLASSIFICATION": "PRO_AUDIT",
    "RENDER_COMPATIBILITY": "UIUX",
    "RGB_COLOR_HARMONIZATION": "UIUX",
    "ANDROID_RENDER_BINDING": "ANDROID_BUILD",
    "WINDOWS_RENDER_BINDING": "WINDOWS_BUILD",
    "RGB_BUTTON_VISUAL_REPLACEMENT": "UIUX",
    "RENDER_STARTUP_SAFE_HZ": "PRO_AUDIT"
  },
  "external_conditions": {
    "NETWORK": {
      "owner": null,
      "action": "DEFER_ONLY_NETWORK_SUBSTEP",
      "product_failure": false,
      "other_departments_continue": true
    },
    "INFRASTRUCTURE": {
      "owner": null,
      "action": "DEFER_ONLY_INFRA_SUBSTEP",
      "product_failure": false,
      "other_departments_continue": true
    },
    "UI_STATUS": {
      "owner": "UIUX",
      "action": "RETURN_FOR_REWORK",
      "product_failure": false,
      "other_departments_continue": true
    }
  },
  "rework_policy": {
    "return_to_owner": true,
    "include_reason": true,
    "include_evidence": true,
    "include_failed_check": true,
    "resume_from_last_checkpoint": true,
    "unrelated_departments_continue": true,
    "max_attempts": "UNTIL_PASS_OR_EXPLICIT_PRODUCT_BLOCKER",
    "network_is_never_default_owner": true
  },
  "completion_policy": {
    "department_complete_requires_pass": true,
    "all_departments_complete_requires_all_pass": true,
    "command_stays_active_until_complete": true,
    "no_chat_state_dependency": true
  },
  "autocheck_contract": {
    "script": "ci/department_autocheck.py",
    "no_early_exit": true,
    "finding_fields": [
      "department",
      "owner",
      "code",
      "path",
      "detail",
      "repair_hint",
      "severity"
    ],
    "rework_queue": "AI_REWORK_QUEUE"
  },
  "cache_update_responsibility": {
    "standard": "continuity/cache-update-standard.xml",
    "violation_code": "CACHE_MTIME_ONLY_DECISION",
    "owner_rule": "RETURN_TO_DEPARTMENT_USING_TIME_ONLY_DECISION",
    "network_is_owner": false
  },
  "review_acceleration": {
    "fast_review": "ci/fast_review.py",
    "concurrent_checks": true,
    "failed_owner_only": true,
    "other_departments_continue": true
  },
  "visual_runtime_evidence_failure_owner": [
    "HOME",
    "UIUX",
    "ANDROID_BUILD",
    "WINDOWS_BUILD"
  ],
  "visual_reference_routing": {
    "standard": "continuity/visual-reference-baseline.json",
    "first_frame_fail_owners": [
      "HOME",
      "UIUX",
      "ANDROID_BUILD",
      "WINDOWS_BUILD"
    ],
    "first_frame_fail_action": "RETURN_FOR_REWORK",
    "unrelated_departments_continue": true,
    "no_production_pass_from_text_markers_only": true
  },
  "theme_pack_hot_swap": {
    "owner": "UIUX",
    "ai_layout_owner": "AI",
    "failure_action": "ROLLBACK_LAST_VERIFIED_PACK_AND_RETURN_UIUX",
    "unrelated_departments_continue": true,
    "no_runtime_restart": true,
    "no_engineering_shell_fallback": true
  },
  "network_resilience": {
    "owner": "UIUX",
    "ai_update_owner": "AI",
    "build_owner": "ANDROID_BUILD",
    "failure_action": "RETURN_ONLY_FAILED_OWNER",
    "unrelated_departments_continue": true
  },
  "professional_audit_policy": {
    "department": "PRO_AUDIT",
    "scope": [
      "ARCHITECTURE",
      "RUNTIME",
      "UIUX",
      "CAD",
      "CAM",
      "SIM",
      "3AX",
      "4AX",
      "5AX",
      "6AX",
      "NC",
      "AI",
      "ANDROID_BUILD",
      "WINDOWS_BUILD",
      "WEB"
    ],
    "action": "AUDIT_CLASSIFY_RETURN_OWNER_REPAIR_REVERIFY",
    "may_override_product_safety_gate": false,
    "may_override_integrity_gate": false,
    "may_claim_binary_device_pass_without_evidence": false
  },
  "clean_code_contract": {
    "authority": "ci/audit_contract.py",
    "pro_ownership_keys": "CENTRALIZED",
    "verifier": "ci/verify_audit_contract.py"
  },
  "render_compatibility": {
    "resolutions": [
      "1080P/FHD+",
      "2K-class",
      "3K-class",
      "UHD/4K+"
    ],
    "refresh_hz": [
      30,
      60,
      90,
      120
    ],
    "default_startup_hz": 60,
    "startup_promotion_delay_ms": 1800,
    "adaptive_high_refresh_opt_in": true,
    "rgb_max_channel_delta": 24,
    "rgb_max_relative_luma_delta": 0.12,
    "animation_luma_swing_max": 0.12,
    "full_color_dither": true,
    "button_visual_hot_replace": true,
    "button_callback_stable": true,
    "button_verified_asset_fallback": true,
    "glass_depth_layers": 4
  }
}
