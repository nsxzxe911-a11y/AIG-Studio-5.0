{
  "schema": "aig-uiux-zh-tw-baseline-v2",
  "product": "AIG Studio 5.0",
  "status": "ACTIVE_UIUX_BASELINE_LIBRARY_COMPLETE",
  "source": {
    "repository_path": "uiux/assets/cam.jpg",
    "provenance_path": "engineering-assets/visuals/cam_visual.jpg",
    "rule": "uiux runtime reads the promoted uiux asset; engineering-assets is provenance/history only"
  },
  "language_policy": {
    "primary": "zh-TW",
    "preserve_tokens": [
      "AIG",
      "CAD",
      "CAM",
      "SIM",
      "NC",
      "3D",
      "3AX",
      "4AX",
      "5AX",
      "RGB",
      "AI",
      "Fanuc",
      "G54",
      "G90",
      "G41",
      "G42",
      "G/M/X/Y/Z/F/S/T"
    ],
    "fallback_order": [
      "short_zh-TW",
      "abbreviation",
      "symbol",
      "short_English"
    ],
    "no_overlap": true,
    "no_tiny_text": true
  },
  "visual_contract": {
    "family": "AIG_RGB_GLASS",
    "dark_metallic": true,
    "cyan": "rapid/navigation",
    "green": "ready/cutting/safe",
    "magenta": "selected/5AX",
    "violet": "secondary/AI",
    "amber": "warning/safe-z/work-offset",
    "red": "alarm/collision",
    "states": [
      "Normal",
      "Pressed",
      "Selected",
      "Disabled",
      "Alarm"
    ]
  },
  "layout_contract": {
    "derive_from_baseline": true,
    "adaptive": [
      "Android portrait",
      "Android landscape",
      "Windows"
    ],
    "screens": [
      "HOME",
      "CAD",
      "CAM",
      "SIM",
      "3AX",
      "4AX",
      "5AX",
      "MACHINE",
      "NC_EDIT",
      "AI",
      "CONTINUITY"
    ],
    "engineering_shell_visible": false,
    "production_ui_first": true
  },
  "development_order": [
    "HOME",
    "CAD",
    "CAM",
    "SIM",
    "3AX",
    "4AX",
    "5AX",
    "MACHINE",
    "NC_EDIT",
    "AI",
    "CONTINUITY"
  ],
  "library_manifest": "uiux/aig-image-library.json",
  "release_version": "270.0.0",
  "continuity_contract": {
    "mode": "RESUME_FROM_LAST_CHECKPOINT",
    "red_status_nonblocking_for": [
      "NETWORK",
      "INFRASTRUCTURE",
      "UI_STATUS"
    ],
    "release_blocking_for": [
      "PRODUCT_SAFETY",
      "COMPILE_RUNTIME",
      "INTEGRITY"
    ]
  },
  "release_command_contract": {
    "command": "RELEASE_ALL_DEPARTMENTS_EXECUTE",
    "scope": "ALL_DEPARTMENTS",
    "network_blocks_command": false,
    "offline_local_execution": true
  },
  "ai_responsibility_contract": {
    "detector": "AI",
    "route": "OWNER_REWORK",
    "reverify": true,
    "network_default_owner": false
  },
  "department_autocheck": {
    "mode": "全 13 部門一次掃描，不因第一個錯誤提前停止",
    "finding": "部門 / owner / 錯誤碼 / 路徑 / 證據 / 修復提示",
    "rework": "只退回責任部門，其餘部門繼續"
  },
  "version_display_policy": "UI/UX 頁面禁止硬編碼數字版本；release-version.properties 為唯一版本權威",
  "cache_update_notice": {
    "announcement": "所有部門快取更新以 XML 內容、revision、SHA-256 digest、source exact SHA 為標準；禁止只看加工時間/mtime/lastModified 判斷。",
    "canonical": "continuity/cache-update-standard.xml",
    "time_fields": "僅供顯示與診斷，不具更新決策權"
  },
  "review_acceleration_notice": {
    "mode": "快審核 / Android / Windows 三線平行",
    "cache": "Android SDK 本機快取優先，缺少才使用網路補齊",
    "failure": "只打回失敗責任部門，其餘部門繼續",
    "standard": "不降低 CNC 安全、完整性、編譯與 exact SHA 驗證"
  }
}
